// Core smoke test. One instruction per line, see core_tb.sv for expected results.
00500093  // 000: addi x1, x0, 5          # x1 = 5
FFD00113  // 004: addi x2, x0, -3         # x2 = -3
002081B3  // 008: add  x3, x1, x2         # x3 = 2
40208233  // 00C: sub  x4, x1, x2         # x4 = 8
001122B3  // 010: slt  x5, x2, x1         # x5 = 1 (signed -3 < 5)
00113333  // 014: sltu x6, x2, x1         # x6 = 0 (unsigned 0xFFFFFFFD > 5)
100003B7  // 018: lui  x7, 0x10000        # x7 = 0x10000000 (data RAM)
0023A023  // 01C: sw   x2, 0(x7)          # mem = 0xFFFFFFFD
00038403  // 020: lb   x8, 0(x7)          # x8 = 0xFFFFFFFD
0013C483  // 024: lbu  x9, 1(x7)          # x9 = 0x000000FF
00138123  // 028: sb   x1, 2(x7)          # mem = 0xFF05FFFD
0003A503  // 02C: lw   x10, 0(x7)         # x10 = 0xFF05FFFD
00239583  // 030: lh   x11, 2(x7)         # x11 = 0xFFFFFF05
00139123  // 034: sh   x1, 2(x7)          # mem = 0x0005FFFD
0023D603  // 038: lhu  x12, 2(x7)         # x12 = 0x00000005
00000693  // 03C: addi x13, x0, 0         # sum = 0
00400713  // 040: addi x14, x0, 4         # i = 4
00E686B3  // 044: add  x13, x13, x14      # loop: sum += i
FFF70713  // 048: addi x14, x14, -1       # i--
FE071CE3  // 04C: bne  x14, x0, loop      # x13 = 10, x14 = 0
00C007EF  // 050: jal  x15, func          # call, x15 = 0x54
00100813  // 054: addi x16, x0, 1         # after return: x16 = 1
00C0006F  // 058: jal  x0, end            # skip over func
00700893  // 05C: addi x17, x0, 7         # func: x17 = 7
00078067  // 060: jalr x0, 0(x15)         # return
00000917  // 064: auipc x18, 0            # end: x18 = 0x64
40115993  // 068: srai x19, x2, 1         # x19 = 0xFFFFFFFE
01C15A13  // 06C: srli x20, x2, 28        # x20 = 0x0000000F
00114463  // 070: blt  x2, x1, +8         # taken
06300A93  // 074: addi x21, x0, 99        # skipped, x21 stays 0
00115463  // 078: bge  x2, x1, +8         # not taken
02A00B13  // 07C: addi x22, x0, 42        # x22 = 42
00500013  // 080: addi x0, x0, 5          # x0 stays 0
0003A383  // 084: lw   x7, 0(x7)          # x7 = 0x0005FFFD (overwrites its own address)
0000006F  // 088: jal  x0, 0              # done: loop forever
