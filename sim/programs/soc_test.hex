// SoC bus test. See soc_tb.sv for expected results.
100000B7  // 000: lui  x1, 0x10000        # x1 = 0x10000000 (RAM)
04002103  // 004: lw   x2, 0x40(x0)       # x2 = 0xCAFEF00D (constant in ROM)
04100183  // 008: lb   x3, 0x41(x0)       # x3 = 0xFFFFFFF0
04205203  // 00C: lhu  x4, 0x42(x0)       # x4 = 0x0000CAFE
0020A023  // 010: sw   x2, 0(x1)          # RAM[0] = 0xCAFEF00D
0000A283  // 014: lw   x5, 0(x1)          # x5 = 0xCAFEF00D
04202223  // 018: sw   x2, 0x44(x0)       # store to ROM: ignored
04402303  // 01C: lw   x6, 0x44(x0)       # x6 = 0x12345678 (ROM unchanged)
300003B7  // 020: lui  x7, 0x30000        # x7 = 0x30000000 (unmapped)
0013A023  // 024: sw   x1, 0(x7)          # bus_err, dropped (RAM[0] must stay CAFEF00D)
0003A403  // 028: lw   x8, 0(x7)          # bus_err, x8 = 0
00100493  // 02C: addi x9, x0, 1          # still running: x9 = 1
0000006F  // 030: jal  x0, 0              # done: loop forever

// Constants, placed at byte address 0x40 (@ takes a word address)
@10
CAFEF00D  // 040
12345678  // 044
